# 通天晓WMS数据导出 - 环境配置模板
# 复制此文件为 .env 并修改其中的配置

# ====================
# 连接配置
# ====================
TTX_BASE_URL=https://ttx.56xyy.com
TTX_CUSTOMER=xyy-wms-prod
TTX_USERNAME=HFLS17
TTX_PASSWORD=Xyy1234567

# ====================
# 查询条件
# ====================
TTX_WAREHOUSE=HF

# 日期格式: YYYY-MM-DD HH:mm:ss
TTX_START_DATE=2026-02-05 00:00:00
TTX_END_DATE=2026-02-06 23:59:59

# ====================
# 报表类型
# ====================
# receipt_header: 入库单头部
# receipt_details: 入库单明细
# b2c_shipment: B2C出库单
# b2b_shipment: B2B出库单
# paking_details: 分拣单
# data_sync: 数据同步
# all: 全部报表
REPORT_TYPE=receipt_header

# ====================
# 输出配置
# ====================
# csv: 导出CSV文件
# json: 导出JSON文件
# dataSource: 直接插入到API
# both: 同时输出CSV和JSON
OUTPUT_FORMAT=dataSource

OUTPUT_DIR=./output

# ====================
# 入库报表特有条件
# ====================
TTX_RECEIPT_TYPES=CGRK,DBRK,THRK,QTRK,B2BRK,HHRK

# ====================
# B2C出库单特有条件
# ====================
TTX_PROCESS_TYPE=NORMAL
TTX_LEADING_STS_BEGIN=
TTX_LEADING_STS_END=

# ====================
# 入库单头部特有条件
# ====================
TTX_CHECKIN_START_DATE=
TTX_CHECKIN_END_DATE=

# ====================
# 运行配置
# ====================
PAGE_SIZE=500
HEADLESS=true

