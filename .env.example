# 通天晓WMS数据导出 - 环境配置模板
# 复制此文件为 .env 并修改其中的配置

# ====================
# 连接配置
# ====================
TTX_BASE_URL=https://ttx.56xyy.com
TTX_CUSTOMER=xyy-wms-prod
TTX_USERNAME=HFLS17
TTX_PASSWORD=Xyy1234567

# ====================
# 查询条件
# ====================
TTX_WAREHOUSE=HF

# 日期格式: YYYY-MM-DD HH:mm:ss
TTX_START_DATE=2026-02-05 00:00:00
TTX_END_DATE=2026-02-06 23:59:59

# ====================
# 报表类型
# ====================
# receipt_header, receipt_details, b2c_shipment, b2b_shipment, paking_details, all（默认）
# 步骤2时按REPORT_TYPE导出
REPORT_TYPE=all

# ====================
# 输出配置
# ====================
# csv: 导出CSV文件
# json: 导出JSON文件
# dataSource: 直接插入到API
# both: 同时输出CSV和JSON
OUTPUT_FORMAT=dataSource

OUTPUT_DIR=./output

# ====================
# 运行配置
# ====================
PAGE_SIZE=500
HEADLESS=true
# 页面导航超时（毫秒），网络较慢时可调大，默认 60000
TTX_NAVIGATION_TIMEOUT=60000

# ====================
# 数据同步分步执行 (ttx_export.js 功能入口)
# ====================
# 1=删除镜像表, 2=通天晓导出→镜像表, 3=镜像表→临时表, 4=临时表→职能表, 5=临时表清理
# 默认 all，示例: TTX_SYNC_STEP=1,2 或 TTX_SYNC_STEP=1,3,4
TTX_SYNC_STEP=all

# ====================
# 导出任务中心 (ttx_download_center.js)
# ====================
# 从任务中心下载已完成的导出文件，筛选条件：
# TTX_DOWNLOAD_TID=EXPORT_TABLES
# TTX_DOWNLOAD_OID=receipt_header_ex

# 批量插入数据源时每批条数，默认 500
BATCH_INSERT_SIZE=500

# Genespace API
GENISPCE_API_TOKEN=q16Z2piek6iYG3f4TnNwRXyRxa9cp6wdm8ddcEpx
GENISPCE_BASE_URL=https://api.genispace.cn


